{"remainingRequest":"D:\\system\\medicineresource\\src\\main\\resources\\admin\\node_modules\\babel-loader\\lib\\index.js!D:\\system\\medicineresource\\src\\main\\resources\\admin\\node_modules\\cache-loader\\dist\\cjs.js??ref--1-0!D:\\system\\medicineresource\\src\\main\\resources\\admin\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\system\\medicineresource\\src\\main\\resources\\admin\\src\\components\\common\\Editor.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\system\\medicineresource\\src\\main\\resources\\admin\\src\\components\\common\\Editor.vue","mtime":1777185642000},{"path":"D:\\system\\medicineresource\\src\\main\\resources\\admin\\babel.config.js","mtime":1777185640000},{"path":"D:\\system\\medicineresource\\src\\main\\resources\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1778394041341},{"path":"D:\\system\\medicineresource\\src\\main\\resources\\admin\\node_modules\\babel-loader\\lib\\index.js","mtime":1778394042558},{"path":"D:\\system\\medicineresource\\src\\main\\resources\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1778394041341},{"path":"D:\\system\\medicineresource\\src\\main\\resources\\admin\\node_modules\\vue-loader\\lib\\index.js","mtime":1778394043079}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["quillEditor","toolbarOptions","header","list","script","indent","size","color","background","font","align","_EditorOption_","page_this","modules","table","toolbar","container","handlers","image","value","openUploadByType","quill","format","video","file","audio","audioPlay","numberPattern","$prompt","confirmButtonText","cancelButtonText","inputValue","inputPattern","inputErrorMessage","then","_ref","rowValue","rows","Number","_ref2","colValue","cols","_ref3","tableModule","getModule","insertTable","$message","error","catch","placeholder","initButton","document","querySelector","title","style","cssText","className","insertTableBtn","fileBtn","props","type","String","action","maxSize","default","myQuillEditor","components","mounted","editorOption","data","refname","content","quillUpdateImg","uploadEmbedType","$storage","get","computed","getActionUrl","concat","$base","name","uploadAccept","methods","_this","$nextTick","uploadInput","setAttribute","click","div","createElement","innerHTML","text","textContent","utterance","SpeechSynthesisUtterance","lang","rate","pitch","volume","window","speechSynthesis","speak","onEditorBlur","onEditorFocus","onEditorChange","$emit","beforeUpload","isVideoUpload","isValidType","startsWith","uploadSuccess","res","$refs","code","selection","getSelection","length","index","getLength","fileUrl","url","fileName","safeFileName","replace","safeFileUrl","clipboard","dangerouslyPasteHTML","insertEmbed","setSelection","uploadError"],"sources":["src/components/common/Editor.vue"],"sourcesContent":["<template>\r\n\t<div>\r\n\t\t<!-- 图片上传组件辅助-->\r\n\t\t<el-upload :class=\"refname + 'upload'\" :action=\"getActionUrl\" name=\"file\" :headers=\"header\" :show-file-list=\"false\"\r\n\t\t\t:accept=\"uploadAccept\"\r\n\t\t\t:on-success=\"uploadSuccess\" :on-error=\"uploadError\" :before-upload=\"beforeUpload\"></el-upload>\r\n\r\n\t\t<quill-editor class=\"editor\" v-model=\"value\" :ref=\"myQuillEditor\" :options=\"editorOption\"\r\n\t\t\t@blur=\"onEditorBlur($event)\" @focus=\"onEditorFocus($event)\" @change=\"onEditorChange($event)\"></quill-editor>\r\n\t</div>\r\n</template>\r\n<script>\r\n\timport { quillEditor } from \"vue-quill-editor-support-insert-table\";\r\n\timport \"quill/dist/quill.core.css\";\r\n\timport \"quill/dist/quill.snow.css\";\r\n\timport \"quill/dist/quill.bubble.css\";\r\n\r\n\t// 工具栏配置\r\n\tconst toolbarOptions = [\r\n\t\t[\"bold\", \"italic\", \"underline\", \"strike\"], // 加粗 斜体 下划线 删除线\r\n\t\t[\"blockquote\", \"code-block\"], // 引用  代码块\r\n\t\t[{\r\n\t\t\theader: 1\r\n\t\t}, {\r\n\t\t\theader: 2\r\n\t\t}], // 1、2 级标题\r\n\t\t[{\r\n\t\t\tlist: \"ordered\"\r\n\t\t}, {\r\n\t\t\tlist: \"bullet\"\r\n\t\t}], // 有序、无序列表\r\n\t\t[{\r\n\t\t\tscript: \"sub\"\r\n\t\t}, {\r\n\t\t\tscript: \"super\"\r\n\t\t}], // 上标/下标\r\n\t\t[{\r\n\t\t\tindent: \"-1\"\r\n\t\t}, {\r\n\t\t\tindent: \"+1\"\r\n\t\t}], // 缩进\r\n\t\t// [{'direction': 'rtl'}],                         // 文本方向\r\n\t\t[{\r\n\t\t\tsize: [\"small\", false, \"large\", \"huge\"]\r\n\t\t}], // 字体大小\r\n\t\t[{\r\n\t\t\theader: [1, 2, 3, 4, 5, 6, false]\r\n\t\t}], // 标题\r\n\t\t[{\r\n\t\t\tcolor: []\r\n\t\t}, {\r\n\t\t\tbackground: []\r\n\t\t}], // 字体颜色、字体背景颜色\r\n\t\t[{\r\n\t\t\tfont: []\r\n\t\t}], // 字体种类\r\n\t\t[{\r\n\t\t\talign: []\r\n\t\t}], // 对齐方式\r\n\t\t[\"clean\"], // 清除文本格式\r\n\t\t[\"link\", \"image\", \"video\", \"file\", \"audio\", \"table\"], // 链接、图片、视频、文件、插入表格\r\n\t];\r\n\tvar _EditorOption_ = function(page_this) {\r\n\t\treturn {\r\n\t\t\tmodules: {\r\n\t\t\t\ttable: true,\r\n\t\t\t\ttoolbar: {\r\n\t\t\t\t\tcontainer: toolbarOptions,\r\n\t\t\t\t\thandlers: {\r\n\t\t\t\t\t\timage(value) {\r\n\t\t\t\t\t\t\tif (value) {\r\n\t\t\t\t\t\t\t\tpage_this.openUploadByType(\"image\");\r\n\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\tthis.quill.format(\"image\", false);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\tvideo(value) {\r\n\t\t\t\t\t\t\tif (value) {\r\n\t\t\t\t\t\t\t\tpage_this.openUploadByType(\"video\");\r\n\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\tthis.quill.format(\"video\", false);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\tfile(value) {\r\n\t\t\t\t\t\t\tif (value) {\r\n\t\t\t\t\t\t\t\tpage_this.openUploadByType(\"file\");\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\taudio(value) {\r\n\t\t\t\t\t\t\tpage_this.audioPlay()\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\ttable() {\r\n\t\t\t\t\t\t\tconst quill = this.quill;\r\n\t\t\t\t\t\t\tconst numberPattern = /^([1-9]|1\\d|20)$/;\r\n\t\t\t\t\t\t\tpage_this.$prompt(\"请输入表格行数（1-20）\", \"插入表格\", {\r\n\t\t\t\t\t\t\t\tconfirmButtonText: \"下一步\",\r\n\t\t\t\t\t\t\t\tcancelButtonText: \"取消\",\r\n\t\t\t\t\t\t\t\tinputValue: \"3\",\r\n\t\t\t\t\t\t\t\tinputPattern: numberPattern,\r\n\t\t\t\t\t\t\t\tinputErrorMessage: \"请输入 1-20 的整数\",\r\n\t\t\t\t\t\t\t}).then(({\r\n\t\t\t\t\t\t\t\tvalue: rowValue\r\n\t\t\t\t\t\t\t}) => {\r\n\t\t\t\t\t\t\t\tconst rows = Number(rowValue);\r\n\t\t\t\t\t\t\t\treturn page_this.$prompt(\"请输入表格列数（1-20）\", \"插入表格\", {\r\n\t\t\t\t\t\t\t\t\tconfirmButtonText: \"插入\",\r\n\t\t\t\t\t\t\t\t\tcancelButtonText: \"取消\",\r\n\t\t\t\t\t\t\t\t\tinputValue: \"3\",\r\n\t\t\t\t\t\t\t\t\tinputPattern: numberPattern,\r\n\t\t\t\t\t\t\t\t\tinputErrorMessage: \"请输入 1-20 的整数\",\r\n\t\t\t\t\t\t\t\t}).then(({\r\n\t\t\t\t\t\t\t\t\tvalue: colValue\r\n\t\t\t\t\t\t\t\t}) => ({\r\n\t\t\t\t\t\t\t\t\trows,\r\n\t\t\t\t\t\t\t\t\tcols: Number(colValue),\r\n\t\t\t\t\t\t\t\t}));\r\n\t\t\t\t\t\t\t}).then(({\r\n\t\t\t\t\t\t\t\trows,\r\n\t\t\t\t\t\t\t\tcols\r\n\t\t\t\t\t\t\t}) => {\r\n\t\t\t\t\t\t\t\tconst tableModule = quill.getModule(\"table\");\r\n\t\t\t\t\t\t\t\tif (tableModule && typeof tableModule.insertTable === \"function\") {\r\n\t\t\t\t\t\t\t\t\ttableModule.insertTable(rows, cols);\r\n\t\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\t\tpage_this.$message.error(\"表格模块未加载\");\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}).catch(() => {});\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t},\r\n\t\t\t\t},\r\n\t\t\t},\r\n\t\t\tplaceholder: \"请输入正文\",\r\n\t\t\tinitButton: function () {\r\n\t\t\t\t//在使用的页面中初始化按钮样式\r\n\t\t\t\tconst audio = document.querySelector(\".ql-audio\");\r\n\t\t\t\tif (audio) {\r\n\t\t\t\t\taudio.title = '语言朗读'\r\n\t\t\t\t\taudio.style.cssText =\r\n\t\t\t\t\t\t\"width:28px;height: 24px;color: #000\";\r\n\t\t\t\t\taudio.className = \"icon iconfont icon-gonggao18\";\r\n\t\t\t\t}\r\n\t\t\t\tconst insertTableBtn = document.querySelector(\".ql-table\");\r\n\t\t\t\tif (insertTableBtn) {\r\n\t\t\t\t\tinsertTableBtn.title = \"插入表格\";\r\n\t\t\t\t}\r\n\t\t\t\tconst fileBtn = document.querySelector(\".ql-file\");\r\n\t\t\t\tif (fileBtn) {\r\n\t\t\t\t\tfileBtn.title = \"上传文件\";\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t};\r\n\t};\r\n\r\n\texport default {\r\n\t\tprops: {\r\n\t\t\t/*编辑器的内容*/\r\n\t\t\tvalue: {\r\n\t\t\t\ttype: String\r\n\t\t\t},\r\n\t\t\taction: {\r\n\t\t\t\ttype: String\r\n\t\t\t},\r\n\t\t\t/*图片大小*/\r\n\t\t\tmaxSize: {\r\n\t\t\t\ttype: Number,\r\n\t\t\t\tdefault: 4000 //kb\r\n\t\t\t},\r\n\t\t\tmyQuillEditor: {\r\n\t\t\t\ttype: String\r\n\t\t\t}\r\n\t\t},\r\n\r\n\t\tcomponents: {\r\n\t\t\tquillEditor\r\n\t\t},\r\n\t\tmounted() {\r\n\t\t\tthis.editorOption.initButton();\r\n\t\t},\r\n\t\tdata() {\r\n\t\t\treturn {\r\n\t\t\t\trefname: this.myQuillEditor,\r\n\t\t\t\tcontent: this.value,\r\n\t\t\t\tquillUpdateImg: false, // 根据图片上传状态来确定是否显示loading动画，刚开始是false,不显示\r\n\t\t\t\tuploadEmbedType: \"image\", // 当前上传后插入的富文本类型\r\n\t\t\t\teditorOption: _EditorOption_(this),\r\n\r\n\t\t\t\t// serverUrl: `${base.url}sys/storage/uploadSwiper?token=${storage.get('token')}`, // 这里写你要上传的图片服务器地址\r\n\t\t\t\theader: {\r\n\t\t\t\t\t// token: sessionStorage.token\r\n\t\t\t\t\t'Token': this.$storage.get(\"Token\")\r\n\t\t\t\t} // 有的图片服务器要求请求头需要有token\r\n\t\t\t};\r\n\t\t},\r\n\t\tcomputed: {\r\n\t\t\t// 计算属性的 getter\r\n\t\t\tgetActionUrl: function() {\r\n\t\t\t\t// return this.$base.url + this.action + \"?token=\" + this.$storage.get(\"token\");\r\n\t\t\t\treturn `/${this.$base.name}/` + this.action;\r\n\t\t\t},\r\n\t\t\tuploadAccept() {\r\n\t\t\t\tif (this.uploadEmbedType === \"video\") return \"video/*\";\r\n\t\t\t\tif (this.uploadEmbedType === \"file\") return \"*/*\";\r\n\t\t\t\treturn \"image/*\";\r\n\t\t\t}\r\n\t\t},\r\n\t\tmethods: {\r\n\t\t\topenUploadByType(type) {\r\n\t\t\t\tthis.uploadEmbedType = type;\r\n\t\t\t\t// 等待 DOM 同步 accept 后再打开选择框，避免沿用上一次类型限制\r\n\t\t\t\tthis.$nextTick(() => {\r\n\t\t\t\t\tconst uploadInput = document.querySelector(\".\" + this.refname + \"upload input\");\r\n\t\t\t\t\tif (!uploadInput) return;\r\n\t\t\t\t\tuploadInput.setAttribute(\"accept\", this.uploadAccept);\r\n\t\t\t\t\tuploadInput.click();\r\n\t\t\t\t});\r\n\t\t\t},\r\n\t\t\taudioPlay() {\r\n\t\t\t\tvar div = document.createElement('div')\r\n\t\t\t\tdiv.innerHTML = this.value\r\n\t\t\t\tvar text = div.textContent\r\n\t\t\t\tconst utterance = new SpeechSynthesisUtterance();\r\n\t\t\t\tutterance.text = text;  \r\n\t\t\t\tutterance.lang = 'zh-CN';  \r\n\t\t\t\tutterance.rate = 1.5; // 语速（0.1-10）  \r\n\t\t\t\tutterance.pitch = 1.0; // 音调（0-2）  \r\n\t\t\t\tutterance.volume = 1.0; // 音量（0-1）  \r\n\t\t\t\twindow.speechSynthesis.speak(utterance);  \r\n\t\t\t},\r\n\t\t\tonEditorBlur() {\r\n\t\t\t\t//失去焦点事件\r\n\t\t\t},\r\n\t\t\tonEditorFocus() {\r\n\t\t\t\t//获得焦点事件\r\n\t\t\t},\r\n\t\t\tonEditorChange() {\r\n\t\t\t\t//内容改变事件\r\n\t\t\t\tthis.$emit(\"input\", this.value);\r\n\t\t\t},\r\n\t\t\t// 富文本图片上传前\r\n\t\t\tbeforeUpload(file) {\r\n\t\t\t\tif (!file || !file.type) {\r\n\t\t\t\t\tthis.$message.error(\"无法识别文件类型\");\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t\tif (this.uploadEmbedType === \"file\") {\r\n\t\t\t\t\tthis.quillUpdateImg = true;\r\n\t\t\t\t\treturn true;\r\n\t\t\t\t}\r\n\t\t\t\tconst isVideoUpload = this.uploadEmbedType === \"video\";\r\n\t\t\t\tconst isValidType = isVideoUpload ? file.type.startsWith(\"video/\") : file.type.startsWith(\"image/\");\r\n\t\t\t\tif (!isValidType) {\r\n\t\t\t\t\tthis.$message.error(isVideoUpload ? \"请选择视频类型文件\" : \"请选择图片类型文件\");\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t\t// 显示loading动画\r\n\t\t\t\tthis.quillUpdateImg = true;\r\n\t\t\t\treturn true;\r\n\t\t\t},\r\n\r\n\t\t\tuploadSuccess(res, file) {\r\n\t\t\t\t// res为图片服务器返回的数据\r\n\t\t\t\t// 获取富文本组件实例\r\n\t\t\t\tlet quill = this.$refs[this.refname].quill;\r\n\t\t\t\t// 如果上传成功\r\n\t\t\t\tif (res.code === 0) {\r\n\t\t\t\t\t// 获取光标所在位置\r\n\t\t\t\t\tconst selection = quill.getSelection();\r\n\t\t\t\t\tlet length = selection ? selection.index : quill.getLength();\r\n\t\t\t\t\tconst fileUrl = this.$base.url + \"upload/\" + res.file;\r\n\t\t\t\t\tif (this.uploadEmbedType === \"file\") {\r\n\t\t\t\t\t\tconst fileName = file && file.name ? file.name : (res.file || \"下载文件\");\r\n\t\t\t\t\t\tconst safeFileName = String(fileName).replace(/\"/g, \"&quot;\");\r\n\t\t\t\t\t\tconst safeFileUrl = String(fileUrl).replace(/\"/g, \"&quot;\");\r\n\t\t\t\t\t\tquill.clipboard.dangerouslyPasteHTML(\r\n\t\t\t\t\t\t\tlength,\r\n\t\t\t\t\t\t\t`<a href=\"${safeFileUrl}\" download=\"${safeFileName}\" target=\"_blank\" rel=\"noopener noreferrer\">${safeFileName}</a>`\r\n\t\t\t\t\t\t);\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\t// 按按钮类型插入图片或视频\r\n\t\t\t\t\t\tquill.insertEmbed(length, this.uploadEmbedType, fileUrl);\r\n\t\t\t\t\t}\r\n\t\t\t\t\t// 调整光标到最后\r\n\t\t\t\t\tquill.setSelection(length + 1);\r\n\t\t\t\t} else {\r\n\t\t\t\t\tthis.$message.error(this.uploadEmbedType === \"video\" ? \"视频插入失败\" : (this.uploadEmbedType === \"file\" ? \"文件插入失败\" : \"图片插入失败\"));\r\n\t\t\t\t}\r\n\t\t\t\t// loading动画消失\r\n\t\t\t\tthis.quillUpdateImg = false;\r\n\t\t\t\tthis.uploadEmbedType = \"image\";\r\n\t\t\t},\r\n\t\t\t// 富文本图片上传失败\r\n\t\t\tuploadError() {\r\n\t\t\t\t// loading动画消失\r\n\t\t\t\tthis.quillUpdateImg = false;\r\n\t\t\t\tthis.$message.error(this.uploadEmbedType === \"video\" ? \"视频插入失败\" : (this.uploadEmbedType === \"file\" ? \"文件插入失败\" : \"图片插入失败\"));\r\n\t\t\t\tthis.uploadEmbedType = \"image\";\r\n\t\t\t}\r\n\t\t}\r\n\t};\r\n</script>\r\n\r\n<style>\r\n\t.editor .ql-toolbar .ql-table {\r\n\t\twidth: auto !important;\r\n\t\tpadding: 0 6px !important;\r\n\t\tfont-size: 12px;\r\n\t}\r\n\t.editor .ql-toolbar .ql-table::before {\r\n\t\tcontent: \"表格\";\r\n\t}\r\n\t.editor .ql-toolbar .ql-file {\r\n\t\twidth: auto !important;\r\n\t\tpadding: 0 6px !important;\r\n\t\tfont-size: 12px;\r\n\t}\r\n\t.editor .ql-toolbar .ql-file::before {\r\n\t\tcontent: \"文件\";\r\n\t}\r\n\r\n\t.editor {\r\n\t\tline-height: normal !important;\r\n\t}\r\n\r\n\t.ql-snow .ql-tooltip[data-mode=\"link\"]::before {\r\n\t\tcontent: \"请输入链接地址:\";\r\n\t}\r\n\r\n\t.ql-snow .ql-tooltip.ql-editing a.ql-action::after {\r\n\t\tborder-right: 0px;\r\n\t\tcontent: \"保存\";\r\n\t\tpadding-right: 0px;\r\n\t}\r\n\r\n\t.ql-snow .ql-