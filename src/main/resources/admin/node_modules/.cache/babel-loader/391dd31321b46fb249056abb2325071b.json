t\t\t\t\t\tif (data) {\n\t\t\t\t\t\t\tconst binaryData = [];\n\t\t\t\t\t\t\tbinaryData.push(data);\n\t\t\t\t\t\t\tconst objectUrl = window.URL.createObjectURL(new Blob(binaryData, {\n\t\t\t\t\t\t\t\ttype: 'application/pdf;chartset=UTF-8'\n\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t\tconst a = document.createElement('a')\n\t\t\t\t\t\t\ta.href = objectUrl\n\t\t\t\t\t\t\ta.download = 'mysql.dmp'\n\t\t\t\t\t\t\t// a.click()\n\t\t\t\t\t\t\t// 下面这个写法兼容火狐\n\t\t\t\t\t\t\ta.dispatchEvent(new MouseEvent('click', {\n\t\t\t\t\t\t\t\tbubbles: true,\n\t\t\t\t\t\t\t\tcancelable: true,\n\t\t\t\t\t\t\t\tview: window\n\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t\twindow.URL.revokeObjectURL(data)\n\t\t\t\t\t\t\tmessage.message(\"数据备份成功\")\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tlet message = this.$message\n\t\t\t\t\t\t\tmessage.error(data.msg);\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\t\t\t\t});\n\t\t\t},\n\t\t}\r\n\t};\r\n</script>\r\n\r\n\r\n<style lang=\"scss\" scoped>\r\n\t.navbar {\r\n\t\t.title {\r\n\t\t\tmargin: 0 auto 0 0;\r\n\t\t\tdisplay: block;\r\n\t\t\t.title-name {\r\n\t\t\t\tpadding: 0;\r\n\t\t\t\tcolor: #8ebc74;\r\n\t\t\t\tfont-weight: 500;\r\n\t\t\t\tfont-size: 30px;\r\n\t\t\t\tline-height: 44px;\r\n\t\t\t\tfloat: left;\r\n\t\t\t}\r\n\t\t}\r\n\t\t.weather {\r\n\t\t\tpadding: 0;\r\n\t\t\tmargin: 0 50px 0 0;\r\n\t\t\talign-content: center;\r\n\t\t\tdisplay: flex;\r\n\t\t\twidth: 250px;\r\n\t\t\tfont-size: 15px;\r\n\t\t\tjustify-content: center;\r\n\t\t\talign-items: center;\r\n\t\t\tflex-wrap: wrap;\r\n\t\t\torder: 2;\r\n\t\t\tdiv:nth-child(1) {\r\n\t\t\t\tpadding: 0 4px;\r\n\t\t\t\tcolor: inherit;\r\n\t\t\t\twhite-space: nowrap;\r\n\t\t\t\tfont-size: inherit;\r\n\t\t\t\tline-height: 1.5;\r\n\t\t\t}\r\n\t\t\tdiv:nth-child(2) {\r\n\t\t\t\tpadding: 0 4px;\r\n\t\t\t\tcolor: inherit;\r\n\t\t\t\tfont-size: inherit;\r\n\t\t\t\tline-height: 1.5;\r\n\t\t\t}\r\n\t\t\tdiv:nth-child(3) {\r\n\t\t\t\tpadding: 0 4px;\r\n\t\t\t\tcolor: inherit;\r\n\t\t\t\tfont-size: inherit;\r\n\t\t\t\tline-height: 1.5;\r\n\t\t\t}\r\n\t\t