tion=\"file/upload\"\r\n\t\t\t\t\t\t:limit=\"3\"\r\n\t\t\t\t\t\t:multiple=\"true\"\r\n\t\t\t\t\t\t:disabled=\"ro.cpicture\"\r\n\t\t\t\t\t\t:fileUrls=\"ruleForm.cpicture?ruleForm.cpicture:''\"\r\n\t\t\t\t\t\t@change=\"cpictureUploadChange\"\r\n\t\t\t\t\t></file-upload>\r\n\t\t\t\t</el-form-item>\r\n\t\t\t\t<el-form-item class=\"upload\" v-if=\"type!='info' && !ro.rpicture\" label=\"回复图片\" prop=\"rpicture\" >\r\n\t\t\t\t\t<file-upload\r\n\t\t\t\t\t\ttip=\"点击上传回复图片\"\r\n\t\t\t\t\t\taction=\"file/upload\"\r\n\t\t\t\t\t\t:limit=\"3\"\r\n\t\t\t\t\t\t:disabled=\"ro.rpicture\"\r\n\t\t\t\t\t\t:multiple=\"true\"\r\n\t\t\t\t\t\t:fileUrls=\"ruleForm.rpicture?ruleForm.rpicture:''\"\r\n\t\t\t\t\t\t@change=\"rpictureUploadChange\"\r\n\t\t\t\t\t></file-upload>\r\n\t\t\t\t</el-form-item>\r\n\t\t\t\t<el-form-item class=\"upload\" v-else-if=\"ruleForm.rpicture\" label=\"回复图片\" prop=\"rpicture\" >\r\n\t\t\t\t\t<img v-if=\"ruleForm.rpicture.substring(0,4)=='http'&&ruleForm.rpicture.split(',w').length>1\" class=\"upload-img\" style=\"margin-right:20px;\" v-bind:key=\"index\" :src=\"ruleForm.rpicture\" width=\"100\" height=\"100\" @click=\"imgPreView(ruleForm.tupian)\">\r\n\t\t\t\t\t<img v-else-if=\"ruleForm.rpicture.substring(0,4)=='http'\" class=\"upload-img\" style=\"margin-right:20px;\" v-bind:key=\"index\" :src=\"ruleForm.rpicture.split(',')[0]\" width=\"100\" height=\"100\" @click=\"imgPreView(ruleForm.tupian.split(',')[0])\">\r\n\t\t\t\t\t<img v-else class=\"upload-img\" style=\"margin-right:20px;\" v-bind:key=\"index\" v-for=\"(item,index) in ruleForm.rpicture.split(',')\" :src=\"$base.url+item\" width=\"100\" height=\"100\" @click=\"imgPreView($base.url+item)\">\r\n\t\t\t\t</el-form-item>\r\n\t\t\t</template>\r\n\t\t\t<el-form-item v-if=\"type=='msg'\" label=\"留言内容\" prop=\"content\" class=\"textBox\">\r\n\t\t\t\t<span class=\"text ql-snow ql-editor\" v-html=\"ruleForm.content\"></span>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item v-else label=\"留言内容\" prop=\"content\" class=\"editorBox\">\r\n\t\t\t\t<editor \r\n\t\t\t\t\tv-model=\"ruleForm.content\" \r\n\t\t\t\t\tclass=\"editor\"\r\n\t\t\t\t\tmyQuillEditor=\"content\"\r\n\t\t\t\t\taction=\"file/upload\">\r\n\t\t\t\t</editor>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item v-if=\"type!='info'\"  label=\"回复内容\" prop=\"reply\" class=\"editorBox\">\r\n\t\t\t\t<editor \r\n\t\t\t\t\tv-model=\"ruleForm.reply\" \r\n\t\t\t\t\tclass=\"editor\"\r\n\t\t\t\t\tmyQuillEditor=\"reply\"\r\n\t\t\t\t\taction=\"file/upload\">\r\n\t\t\t\t</editor>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item v-else-if=\"ruleForm.reply\" label=\"回复内容\" prop=\"reply\" class=\"textBox\">\r\n\t\t\t\t<span class=\"text ql-snow ql-editor\" v-html=\"ruleForm.reply\"></span>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"btn\">\r\n\t\t\t\t<el-button class=\"btn3\"  v-if=\"type!='info'\" type=\"success\" @click=\"onSubmit\">\r\n\t\t\t\t\t<span class=\"icon iconfont icon-queren15\"></span>\r\n\t\t\t\t\t确定\r\n\t\t\t\t</el-button>\r\n\t\t\t\t<el-button class=\"btn4\" v-if=\"type!='info'\" type=\"success\" @click=\"back()\">\r\n\t\t\t\t\t<span class=\"icon iconfont icon-guanbi2\"></span>\r\n\t\t\t\t\t撤销\r\n\t\t\t\t</el-button>\r\n\t\t\t\t<el-button class=\"btn5\" v-if=\"type=='info'\" type=\"success\" @click=\"back()\">\r\n\t\t\t\t\t<span class=\"icon iconfont icon-fanhui13\"></span>\r\n\t\t\t\t\t返回\r\n\t\t\t\t</el-button>\r\n\t\t\t</el-form-item>\r\n\t\t</el-form>\r\n    \r\n\r\n\t</div>\r\n</template>\r\n<script>\r\n\texport default {\r\n\t\tdata() {\r\n\t\t\treturn {\r\n\t\t\t\tid: '',\r\n\t\t\t\ttype: '',\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\tro:{\r\n\t\t\t\t\tuserid : false,\r\n\t\t\t\t\tusername : false,\r\n\t\t\t\t\tavatarurl : false,\r\n\t\t\t\t\tcontent : false,\r\n\t\t\t\t\tcpicture : false,\r\n\t\t\t\t\treply : false,\r\n\t\t\t\t\trpicture : false,\r\n\t\t\t\t},\r\n\t\t\t\r\n\t\t\t\truleForm: {\r\n\t\t\t\t\tuserid: '',\r\n\t\t\t\t\tusername: '',\r\n\t\t\t\t\tavatarurl: '',\r\n\t\t\t\t\tcontent: '',\r\n\t\t\t\t\tcpicture: