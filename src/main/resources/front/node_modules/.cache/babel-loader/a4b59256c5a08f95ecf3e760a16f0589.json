Form.ziyuantupian.split(',')\" :src=\"baseUrl+item\">\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\"  label=\"资源分类\" prop=\"ziyuanfenlei\">\r\n\t\t\t\t<el-select v-model=\"ruleForm.ziyuanfenlei\" placeholder=\"请选择资源分类\" :disabled=\"ro.ziyuanfenlei\"  filterable>\r\n\t\t\t\t\t<el-option\r\n\t\t\t\t\t\tv-for=\"(item,index) in ziyuanfenleiOptions\"\r\n\t\t\t\t\t\t:key=\"index\"\r\n\t\t\t\t\t\t:label=\"item\"\r\n\t\t\t\t\t\t:value=\"item\">\r\n\t\t\t\t\t</el-option>\r\n\t\t\t\t</el-select>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"注意事项\" prop=\"zhuyishixiang\">\r\n\t\t\t\t<el-input v-model=\"ruleForm.zhuyishixiang\" \r\n\t\t\t\t\tplaceholder=\"注意事项\" clearable :readonly=\"ro.zhuyishixiang\"></el-input>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"资源价格\" prop=\"ziyuanjiage\">\r\n\t\t\t\t<el-input-number v-model=\"ruleForm.ziyuanjiage\" placeholder=\"资源价格\" :disabled=\"ro.ziyuanjiage\"></el-input-number>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"排队人数\" prop=\"paiduirenshu\">\r\n\t\t\t\t<el-input v-model.number=\"ruleForm.paiduirenshu\" \r\n\t\t\t\t\tplaceholder=\"排队人数\" clearable :readonly=\"ro.paiduirenshu\"></el-input>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"资源用途\" prop=\"ziyuanyongtu\">\r\n\t\t\t\t<el-input\r\n\t\t\t\t\ttype=\"textarea\"\r\n\t\t\t\t\t:rows=\"8\"\r\n\t\t\t\t\t:disabled=\"ro.ziyuanyongtu\"\r\n\t\t\t\t\tplaceholder=\"资源用途\"\r\n\t\t\t\t\tv-model=\"ruleForm.ziyuanyongtu\">\r\n\t\t\t\t\t</el-input>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"资源简介\" prop=\"ziyuanjianjie\">\r\n\t\t\t\t<editor \r\n\t\t\t\t\tv-model=\"ruleForm.ziyuanjianjie\" \r\n\t\t\t\t\tclass=\"editor\" \r\n\t\t\t\t\tmyQuillEditor=\"ziyuanjianjie\"\r\n\t\t\t\t\taction=\"file/upload\">\r\n\t\t\t\t</editor>\r\n\t\t\t</el-form-item>\r\n\r\n\t\t\t<el-form-item class=\"add-btn-item\">\r\n\t\t\t\t<el-button class=\"submitBtn\"  type=\"primary\" @click=\"onSubmit(null)\">\r\n\t\t\t\t\t<span class=\"icon iconfont icon-xiugai2\"></span>\r\n\t\t\t\t\t<span class=\"text\">提交信息</span>\r\n\t\t\t\t</el-button>\r\n\t\t\t\t<el-button class=\"closeBtn\" @click=\"back()\">\r\n\t\t\t\t\t<span class=\"icon iconfont icon-shanchu7\"></span>\r\n\t\t\t\t\t<span class=\"text\">取消</span>\r\n\t\t\t\t</el-button>\r\n\t\t\t</el-form-item>\r\n\t\t</el-form>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\n\texport default {\r\n\t\tdata() {\r\n\t\t\treturn {\r\n\t\t\t\tid: '',\r\n\t\t\t\tbaseUrl: '',\r\n\t\t\t\tro:{\r\n\t\t\t\t\tziyuanbianhao : false,\r\n\t\t\t\t\tziyuanmingcheng : false,\r\n\t\t\t\t\tziyuantupian : false,\r\n\t\t\t\t\tziyuanfenlei : false,\r\n\t\t\t\t\tzhuyishixiang : false,\r\n\t\t\t\t\tziyuanjiage : false,\r\n\t\t\t\t\tpaiduirenshu : false,\r\n\t\t\t\t\tziyuanyongtu : false,\r\n\t\t\t\t\tziyuanjianjie : false,\r\n\t\t\t\t\tclicknum : false,\r\n\t\t\t\t\tdiscussnum : false,\r\n\t\t\t\t\tstoreupnum : false,\r\n\t\t\t\t},\r\n\t\t\t\ttype: '',\r\n\t\t\t\tuserTableName: localStorage.getItem('UserTableName'),\r\n\t\t\t\truleForm: {\r\n\t\t\t\t\tziyuanbianhao: this.getUUID(),\r\n\t\t\t\t\tziyuanmingcheng: '',\r\n\t\t\t\t\tziyuantupian: '',\r\n\t\t\t\t\tziyuanfenlei: '',\r\n\t\t\t\t\tzhuyishixiang: '',\r\n\t\t\t\t\tziyuanjiage: '',\r\n\t\t\t\t\tpaiduirenshu: Number('0') ,\r\n\t\t\t\t\tziyuanyongtu: '',\r\n\t\t\t\t\tziyuanjianjie: '',\r\n\t\t\t\t\tclicknum: '',\r\n\t\t\t\t\tdiscussnum: '',\r\n\t\t\t\t\tstoreupnum: '',\r\n\t\t\t\t},\r\n\t\t\t\tziyuanfenleiOptions: [],\r\n\r\n\t\t\t\trules: {\r\n\t\t\t\t\tziyuanbianhao: [\r\n\t\t\t\t\t\t{ required: true, message: '资源编号不能为空', trigger: 'blur' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\tziyuanmingcheng: [\r\n\t\t\t\t\t\t{ required: true, message: '资源名称不能为空', trigger: 'blur' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\tziyuantupian: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\tziyuanfenlei: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\tzhuyishixiang: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\tziyuanjiage: [\r\n\t\t\t\t\t\t{ required: true, message: '资源价格不能为空', trigger: 'blur' },\r\n\t\t\t\t\t\t{ validator: this.$validate.isNumber, trigger: 'blur' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\tpaiduirenshu: [\r\n\t\t\t\t\t\t{ validator: this.$validate.isIntNumer, trigger: 'blur' },\r\n\t\t\t\t\t\t{ validator: (rule, val, cb) => \r\n\t\t\t\t\t\t\tval >= 0 ? cb() : cb('范围需大于等于0')\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t],\r\n\t\t\t\t\tziyuanyongtu: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\tziyuanjianjie: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\tclicknum: [\r\n\t\t\t\t\t\t{ validator: this.$validate.isIntNumer, trigger: 'blur' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\tdiscussnum: [\r\n\t\t\t\t\t\t{ validator: this.$validate.isIntNumer, trigger: 'blur' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\tstoreupnum: [\r\n\t\t\t\t\t\t{ validator: this.$validate.isIntNumer, trigger: 'blur' },\r\n\t\t\t\t\t],\r\n\t\t\t\t},\r\n\t\t\t\tcenterType: false,\r\n\t\t\t};\r\n\t\t},\r\n\t\tcomputed: {\r\n\t\t\tsessionForm() {\r\n\t\t\t\treturn JSON.parse(localStorage.getItem('sessionForm'))\r\n\t\t\t},\r\n\r\n\r\n\r\n\t\t},\r\n\t\tcomponents: {\r\n\t\t},\r\n\t\tcreated() {\r\n\t\t\tif(this.$route.query.centerType){\r\n\t\t\t\tthis.centerType = true\r\n\t\t\t}\r\n\t\t\t//this.bg();\r\n\t\t\tlet type = this.$route.query.type ? this.$route.query.type : '';\r\n\t\t\tthis.init(type);\r\n\t\t\tthis.baseUrl = this.$config.baseUrl;\r\n\t\t},\r\n\t\tmethods: {\r\n\t\t\tgetMakeZero(s) {\r\n\t\t\t\treturn s < 10 ? '0' + s : s;\r\n\t\t\t},\r\n\t\t\t// 下载\r\n\t\t\tdownload(file ){\r\n\t\t\t\twindow.open(`${file}`)\r\n\t\t\t},\r\n\t\t\t// 初始化\r\n\t\t\tinit(type) {\r\n\t\t\t\tthis.type = type;\r\n\t\t\t\tif(type=='cross'){\r\n\t\t\t\t\tvar obj = JSON.parse(localStorage.getItem('crossObj'));\r\n\t\t\t\t\tfor (var o in obj){\r\n\t\t\t\t\t\tif(o=='ziyuanbianhao'){\r\n\t\t\t\t\t\t\tthis.ruleForm.ziyuanbianhao = obj[o];\r\n\t\t\t\t\t\t\tthis.ro.ziyuanbianhao = true;\r\n\t\t\t\t\t\t\tcontinue;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif(o=='ziyuanmingcheng'){\r\n\t\t\t\t\t\t\tthis.ruleForm.ziyuanmin