{"remainingRequest":"D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\node_modules\\babel-loader\\lib\\index.js!D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\node_modules\\cache-loader\\dist\\cjs.js??ref--1-0!D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\src\\components\\Editor.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\src\\components\\Editor.vue","mtime":1777185650000},{"path":"D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\babel.config.js","mtime":1777185650000},{"path":"D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1778394682263},{"path":"D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\node_modules\\babel-loader\\lib\\index.js","mtime":1778394684643},{"path":"D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1778394682263},{"path":"D:\\system\\springboot73283c2d\\src\\main\\resources\\front\\node_modules\\vue-loader\\lib\\index.js","mtime":1778394685513}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["toolbarOptions","header","list","script","indent","size","color","background","font","align","_EditorOption_","page_this","modules","toolbar","container","handlers","image","value","openUploadByType","quill","format","video","file","audio","audioPlay","placeholder","initButton","document","querySelector","title","style","cssText","className","fileBtn","config","quillEditor","props","type","String","action","maxSize","Number","default","myQuillEditor","components","mounted","editorOption","data","baseUrl","baseUrl2","name","refname","content","quillUpdateImg","uploadEmbedType","localStorage","getItem","computed","getActionUrl","uploadAccept","methods","$nextTick","uploadInput","setAttribute","click","div","createElement","innerHTML","text","textContent","utterance","SpeechSynthesisUtterance","lang","rate","pitch","volume","window","speechSynthesis","speak","onEditorBlur","onEditorFocus","onEditorChange","console","log","$emit","beforeUpload","$message","error","isVideoUpload","isValidType","startsWith","uploadSuccess","res","$refs","code","selection","getSelection","length","index","getLength","fileUrl","fileName","safeFileName","replace","safeFileUrl","clipboard","dangerouslyPasteHTML","insertEmbed","setSelection","uploadError"],"sources":["src/components/Editor.vue"],"sourcesContent":["<template>\r\n\t<div>\n\t\t<!-- 图片上传组件辅助-->\n\t\t<el-upload :class=\"refname + 'upload'\" :action=\"getActionUrl\" name=\"file\" :headers=\"header\" :show-file-list=\"false\"\n\t\t\t:accept=\"uploadAccept\"\n\t\t\t:on-success=\"uploadSuccess\" :on-error=\"uploadError\" :before-upload=\"beforeUpload\"></el-upload>\n\n\t\t<quill-editor class=\"editor\" v-model=\"value\" :ref=\"myQuillEditor\" :options=\"editorOption\"\r\n\t\t\t@blur=\"onEditorBlur($event)\" @focus=\"onEditorFocus($event)\" @change=\"onEditorChange($event)\"></quill-editor>\r\n\t</div>\r\n</template>\r\n<script>\r\n\t// 工具栏配置\r\n\tconst toolbarOptions = [\r\n\t\t[\"bold\", \"italic\", \"underline\", \"strike\"], // 加粗 斜体 下划线 删除线\r\n\t\t[\"blockquote\", \"code-block\"], // 引用  代码块\r\n\t\t[{\r\n\t\t\theader: 1\r\n\t\t}, {\r\n\t\t\theader: 2\r\n\t\t}], // 1、2 级标题\r\n\t\t[{\r\n\t\t\tlist: \"ordered\"\r\n\t\t}, {\r\n\t\t\tlist: \"bullet\"\r\n\t\t}], // 有序、无序列表\r\n\t\t[{\r\n\t\t\tscript: \"sub\"\r\n\t\t}, {\r\n\t\t\tscript: \"super\"\r\n\t\t}], // 上标/下标\r\n\t\t[{\r\n\t\t\tindent: \"-1\"\r\n\t\t}, {\r\n\t\t\tindent: \"+1\"\r\n\t\t}], // 缩进\r\n\t\t[{\r\n\t\t\tsize: [\"small\", false, \"large\", \"huge\"]\r\n\t\t}], // 字体大小\r\n\t\t[{\r\n\t\t\theader: [1, 2, 3, 4, 5, 6, false]\r\n\t\t}], // 标题\r\n\t\t[{\r\n\t\t\tcolor: []\r\n\t\t}, {\r\n\t\t\tbackground: []\r\n\t\t}], // 字体颜色、字体背景颜色\r\n\t\t[{\r\n\t\t\tfont: []\r\n\t\t}], // 字体种类\r\n\t\t[{\r\n\t\t\talign: []\r\n\t\t}], // 对齐方式\r\n\t\t[\"clean\"], // 清除文本格式\r\n\t\t[\"link\", \"image\", \"video\", \"file\", \"audio\"] // 链接、图片、视频\r\n\t];\r\n\tvar _EditorOption_ = function(page_this) {\r\n\t\treturn {\r\n\t\t\tmodules: {\r\n\t\t\t\ttoolbar: {\r\n\t\t\t\t\tcontainer: toolbarOptions,\r\n\t\t\t\t\thandlers: {\r\n\t\t\t\t\t\timage(value) {\n\t\t\t\t\t\t\tif (value) {\n\t\t\t\t\t\t\t\tpage_this.openUploadByType(\"image\");\n\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\tthis.quill.format(\"image\", false);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t},\n\t\t\t\t\t\tvideo(value) {\n\t\t\t\t\t\t\tif (value) {\n\t\t\t\t\t\t\t\tpage_this.openUploadByType(\"video\");\n\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\tthis.quill.format(\"video\", false);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t},\n\t\t\t\t\t\tfile(value) {\n\t\t\t\t\t\t\tif (value) {\n\t\t\t\t\t\t\t\tpage_this.openUploadByType(\"file\");\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\taudio(value) {\r\n\t\t\t\t\t\t\tpage_this.audioPlay()\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t},\r\n\t\t\t\t},\r\n\t\t\t},\r\n\t\t\tplaceholder: \"请输入正文\",\r\n\t\t\tinitButton: function () {\r\n\t\t\t\t//在使用的页面中初始化按钮样式\r\n\t\t\t\tconst audio= document.querySelector(\".ql-audio\");\r\n\t\t\t\taudio.title = '语言朗读'\r\n\t\t\t\taudio.style.cssText =\r\n\t\t\t\t\t\"width:28px;height: 24px;color: #000\";\r\n\t\t\t\taudio.className = \"icon iconfont icon-gonggao18\";\n\t\t\t\tconst fileBtn = document.querySelector(\".ql-file\");\n\t\t\t\tif (fileBtn) {\n\t\t\t\t\tfileBtn.title = \"上传文件\";\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t};\r\n\t};\r\n\timport config from \"@/config/config\";\r\n\timport {\r\n\t\tquillEditor\r\n\t} from \"vue-quill-editor\";\r\n\timport \"quill/dist/quill.core.css\";\r\n\timport \"quill/dist/quill.snow.css\";\r\n\timport \"quill/dist/quill.bubble.css\";\r\n\r\n\texport default {\r\n\t\tprops: {\r\n\t\t\t/*编辑器的内容*/\r\n\t\t\tvalue: {\r\n\t\t\t\ttype: String\r\n\t\t\t},\r\n\t\t\taction: {\r\n\t\t\t\ttype: String\r\n\t\t\t},\r\n\t\t\t/*图片大小*/\r\n\t\t\tmaxSize: {\r\n\t\t\t\ttype: Number,\r\n\t\t\t\tdefault: 4000 //kb\r\n\t\t\t},\r\n\t\t\tmyQuillEditor: {\r\n\t\t\t\ttype: String\r\n\t\t\t}\r\n\t\t},\r\n\r\n\t\tcomponents: {\r\n\t\t\tquillEditor\r\n\t\t},\r\n\t\tmounted() {\r\n\t\t\tthis.editorOption.initButton();\r\n\t\t},\r\n\t\tdata() {\r\n\t\t\treturn {\r\n\t\t\t\tbaseUrl: config.baseUrl,\r\n\t\t\t\tbaseUrl2: config.name,\r\n\t\t\t\trefname: this.myQuillEditor,\r\n\t\t\t\tcontent: this.value,\r\n\t\t\t\tquillUpdateImg: false, // 根据图片上传状态来确定是否显示loading动画，刚开始是false,不显示\r\n\t\t\t\tuploadEmbedType: \"image\", // 当前上传后插入的富文本类型\r\n\t\t\t\teditorOption: _EditorOption_(this),\r\n\t\t\t\theader: {\r\n\t\t\t\t\t'Token': localStorage.getItem('frontToken')\r\n\t\t\t\t} // 有的图片服务器要求请求头需要有token\r\n\t\t\t};\r\n\t\t},\r\n\t\tcomputed: {\r\n\t\t\t// 计算属性的 getter\r\n\t\t\tgetActionUrl: function() {\r\n\t\t\t\treturn this.baseUrl2 + '/' + this.action;\n\t\t\t},\n\t\t\tuploadAccept() {\n\t\t\t\tif (this.uploadEmbedType === \"video\") return \"video/*\";\n\t\t\t\tif (this.uploadEmbedType === \"file\") return \"*/*\";\n\t\t\t\treturn \"image/*\";\n\t\t\t}\r\n\t\t},\r\n\t\tmethods: {\n\t\t\topenUploadByType(type) {\n\t\t\t\tthis.uploadEmbedType = type;\n\t\t\t\t// 等待 DOM 同步 accept 后再打开选择框，避免沿用上一次类型限制\n\t\t\t\tthis.$nextTick(() => {\n\t\t\t\t\tconst uploadInput = document.querySelector(\".\" + this.refname + \"upload input\");\n\t\t\t\t\tif (!uploadInput) return;\n\t\t\t\t\tuploadInput.setAttribute(\"accept\", this.uploadAccept);\n\t\t\t\t\tuploadInput.click();\n\t\t\t\t});\n\t\t\t},\r\n\t\t\taudioPlay() {\r\n\t\t\t\tvar div = document.createElement('div')\r\n\t\t\t\tdiv.innerHTML = this.value\r\n\t\t\t\tvar text = div.textContent\r\n\t\t\t\tconst utterance = new SpeechSynthesisUtterance();\r\n\t\t\t\tutterance.text = text;  \r\n\t\t\t\tutterance.lang = 'zh-CN';  \r\n\t\t\t\tutterance.rate = 1.5; // 语速（0.1-10）  \r\n\t\t\t\tutterance.pitch = 1.0; // 音调（0-2）  \r\n\t\t\t\tutterance.volume = 1.0; // 音量（0-1）  \r\n\t\t\t\twindow.speechSynthesis.speak(utterance);  \r\n\t\t\t},\r\n\t\t\tonEditorBlur() {\r\n\t\t\t\t//失去焦点事件\r\n\t\t\t},\r\n\t\t\tonEditorFocus() {\r\n\t\t\t\t//获得焦点事件\r\n\t\t\t},\r\n\t\t\tonEditorChange() {\r\n\t\t\t\tconsole.log(this.value);\r\n\t\t\t\t//内容改变事件\r\n\t\t\t\tthis.$emit(\"input\", this.value);\r\n\t\t\t},\n\t\t\t// 富文本图片上传前\n\t\t\tbeforeUpload(file) {\n\t\t\t\tif (!file || !file.type) {\n\t\t\t\t\tthis.$message.error(\"无法识别文件类型\");\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t\tif (this.uploadEmbedType === \"file\") {\n\t\t\t\t\tthis.quillUpdateImg = true;\n\t\t\t\t\treturn true;\n\t\t\t\t}\n\t\t\t\tconst isVideoUpload = this.uploadEmbedType === \"video\";\n\t\t\t\tconst isValidType = isVideoUpload ? file.type.startsWith(\"video/\") : file.type.startsWith(\"image/\");\n\t\t\t\tif (!isValidType) {\n\t\t\t\t\tthis.$message.error(isVideoUpload ? \"请选择视频类型文件\" : \"请选择图片类型文件\");\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t\t// 显示loading动画\n\t\t\t\tthis.quillUpdateImg = true;\n\t\t\t\treturn true;\n\t\t\t},\n\n\t\t\tuploadSuccess(res, file) {\n\t\t\t\t// res为图片服务器返回的数据\n\t\t\t\t// 获取富文本组件实例\n\t\t\t\tlet quill = this.$refs[this.refname].quill;\n\t\t\t\t// 如果上传成功\n\t\t\t\tif (res.code === 0) {\n\t\t\t\t\t// 获取光标所在位置\n\t\t\t\t\tconst selection = quill.getSelection();\n\t\t\t\t\tlet length = selection ? selection.index : quill.getLength();\n\t\t\t\t\tconst fileUrl = this.baseUrl + \"upload/\" + res.file;\n\t\t\t\t\tif (this.uploadEmbedType === \"file\") {\n\t\t\t\t\t\tconst fileName = file && file.name ? file.name : (res.file || \"下载文件\");\n\t\t\t\t\t\tconst safeFileName = String(fileName).replace(/\"/g, \"&quot;\");\n\t\t\t\t\t\tconst safeFileUrl = String(fileUrl).replace(/\"/g, \"&quot;\");\n\t\t\t\t\t\tquill.clipboard.dangerouslyPasteHTML(\n\t\t\t\t\t\t\tlength,\n\t\t\t\t\t\t\t`<a href=\"${safeFileUrl}\" download=\"${safeFileName}\" target=\"_blank\" rel=\"noopener noreferrer\">${safeFileName}</a>`\n\t\t\t\t\t\t);\n\t\t\t\t\t} else {\n\t\t\t\t\t\t// 按按钮类型插入图片或视频\n\t\t\t\t\t\tquill.insertEmbed(length, this.uploadEmbedType, fileUrl);\n\t\t\t\t\t}\n\t\t\t\t\t// 调整光标到最后\n\t\t\t\t\tquill.setSelection(length + 1);\n\t\t\t\t} else {\n\t\t\t\t\tthis.$message.error(this.uploadEmbedType === \"video\" ? \"视频插入失败\" : (this.uploadEmbedType === \"file\" ? \"文件插入失败\" : \"图片插入失败\"));\n\t\t\t\t}\n\t\t\t\t// loading动画消失\n\t\t\t\tthis.quillUpdateImg = false;\n\t\t\t\tthis.uploadEmbedType = \"image\";\n\t\t\t},\n\t\t\t// 富文本图片上传失败\n\t\t\tuploadError() {\n\t\t\t\t// loading动画消失\n\t\t\t\tthis.quillUpdateImg = false;\n\t\t\t\tthis.$message.error(this.uploadEmbedType === \"video\" ? \"视频插入失败\" : (this.uploadEmbedType === \"file\" ? \"文件插入失败\" : \"图片插入失败\"));\n\t\t\t\tthis.uploadEmbedType = \"image\";\n\t\t\t}\r\n\t\t}\r\n\t};\r\n</script>\r\n\r\n<style>\r\n\t.editor {\r\n\t\tline-height: normal !important;\r\n\t}\r\n\r\n\t.ql-snow .ql-tooltip[data-mode=\"link\"]::before {\r\n\t\tcontent: \"请输入链接地址:\";\r\n\t}\n\t.editor .ql-toolbar .ql-file {\n\t\twidth: auto !important;\n\t\tpadding: 0 6px !important;\n\t\tfont-size: 12px;\n\t}\n\t.editor .ql-toolbar .ql-file::before {\n\t\tcontent: \"文件\";\n\t}\n\t.editor .ql-editor .ql-video {\n\t\tdisplay: block;\n\t\tmax-width: 100%;\n\t\tmin-width: 240px;\n\t\tmin-height: 135px;\n\t\tresize: both;\n\t\toverflow: auto;\n\t}\r\n\r\n\t.ql-snow .ql-tooltip.ql-editing a.ql-action::after {\r\n\t\tborder-right: 0px;\r\n\t\tcontent: \"保存\";\r\n\t\tpadding-right: 0px;\r\n\t}\r\n\r\n\t.ql-snow .ql-tooltip[data-mode=\"video\"]::before {\r\n\t\tcontent: \"请输入视频地址:\";\r\n\t}\r\n\r\n\t.ql-container {\r\n\t\t/* height: 400px; */\r\n\t}\r\n\r\n\t.ql-snow .ql-picker.ql-size .ql-picker-label::before,\r\n\t.ql-snow .ql-picker.ql-size .ql-picker-item::before {\r\n\t\tcontent: \"14px\";\r\n\t}\r\n\r\n\t.ql-snow .ql-picker.ql-size .ql-picker-label[data-value=\"small\"]::before,\r\n\t.ql-snow .ql-picker.ql-size .ql-picker-item[data-value=\"small\"]::before {\r\n\t\tcontent: \"10px\";\r\n\t}\r\