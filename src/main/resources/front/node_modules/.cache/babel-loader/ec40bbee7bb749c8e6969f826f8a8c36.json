uleForm.touxiang.split(',')[0]\">\r\n\t\t\t\t<img v-else class=\"upload-img\" v-bind:key=\"index\" v-for=\"(item,index) in ruleForm.touxiang.split(',')\" :src=\"baseUrl+item\">\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\"  label=\"性别\" prop=\"xingbie\">\r\n\t\t\t\t<el-select v-model=\"ruleForm.xingbie\" placeholder=\"请选择性别\" :disabled=\"ro.xingbie\"  filterable>\r\n\t\t\t\t\t<el-option\r\n\t\t\t\t\t\tv-for=\"(item,index) in xingbieOptions\"\r\n\t\t\t\t\t\t:key=\"index\"\r\n\t\t\t\t\t\t:label=\"item\"\r\n\t\t\t\t\t\t:value=\"item\">\r\n\t\t\t\t\t</el-option>\r\n\t\t\t\t</el-select>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"年龄\" prop=\"nianling\">\r\n\t\t\t\t<el-input v-model.number=\"ruleForm.nianling\" \r\n\t\t\t\t\tplaceholder=\"年龄\" clearable :readonly=\"ro.nianling\"></el-input>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"联系方式\" prop=\"lianxifangshi\">\r\n\t\t\t\t<el-input v-model=\"ruleForm.lianxifangshi\" \r\n\t\t\t\t\tplaceholder=\"联系方式\" clearable :readonly=\"ro.lianxifangshi\"></el-input>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"家庭住址\" prop=\"jiatingzhuzhi\">\r\n\t\t\t\t<el-input v-model=\"ruleForm.jiatingzhuzhi\" \r\n\t\t\t\t\tplaceholder=\"家庭住址\" clearable :readonly=\"ro.jiatingzhuzhi\"></el-input>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"密保问题\" prop=\"pquestion\">\r\n\t\t\t\t<el-input v-model=\"ruleForm.pquestion\" \r\n\t\t\t\t\tplaceholder=\"密保问题\" clearable :readonly=\"ro.pquestion\"></el-input>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"密保答案\" prop=\"panswer\">\r\n\t\t\t\t<el-input v-model=\"ruleForm.panswer\" \r\n\t\t\t\t\tplaceholder=\"密保答案\" clearable :readonly=\"ro.panswer\"></el-input>\r\n\t\t\t</el-form-item>\r\n\t\t\t<el-form-item class=\"add-item\" label=\"病史\" prop=\"bingshi\">\r\n\t\t\t\t<editor \r\n\t\t\t\t\tv-model=\"ruleForm.bingshi\" \r\n\t\t\t\t\tclass=\"editor\" \r\n\t\t\t\t\tmyQuillEditor=\"bingshi\"\r\n\t\t\t\t\taction=\"file/upload\">\r\n\t\t\t\t</editor>\r\n\t\t\t</el-form-item>\r\n\r\n\t\t\t<el-form-item class=\"add-btn-item\">\r\n\t\t\t\t<el-button class=\"submitBtn\"  type=\"primary\" @click=\"onSubmit(null)\">\r\n\t\t\t\t\t<span class=\"icon iconfont icon-xiugai2\"></span>\r\n\t\t\t\t\t<span class=\"text\">提交信息</span>\r\n\t\t\t\t</el-button>\r\n\t\t\t\t<el-button class=\"closeBtn\" @click=\"back()\">\r\n\t\t\t\t\t<span class=\"icon iconfont icon-shanchu7\"></span>\r\n\t\t\t\t\t<span class=\"text\">取消</span>\r\n\t\t\t\t</el-button>\r\n\t\t\t</el-form-item>\r\n\t\t</el-form>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\n\texport default {\r\n\t\tdata() {\r\n\t\t\treturn {\r\n\t\t\t\tid: '',\r\n\t\t\t\tbaseUrl: '',\r\n\t\t\t\tro:{\r\n\t\t\t\t\tyonghuzhanghao : false,\r\n\t\t\t\t\tmima : false,\r\n\t\t\t\t\tyonghuxingming : false,\r\n\t\t\t\t\ttouxiang : false,\r\n\t\t\t\t\txingbie : false,\r\n\t\t\t\t\tnianling : false,\r\n\t\t\t\t\tlianxifangshi : false,\r\n\t\t\t\t\tjiatingzhuzhi : false,\r\n\t\t\t\t\tbingshi : false,\r\n\t\t\t\t\tpquestion : false,\r\n\t\t\t\t\tpanswer : false,\r\n\t\t\t\t},\r\n\t\t\t\ttype: '',\r\n\t\t\t\tuserTableName: localStorage.getItem('UserTableName'),\r\n\t\t\t\truleForm: {\r\n\t\t\t\t\tyonghuzhanghao: '',\r\n\t\t\t\t\tmima: '',\r\n\t\t\t\t\tyonghuxingming: '',\r\n\t\t\t\t\ttouxiang: '',\r\n\t\t\t\t\txingbie: '',\r\n\t\t\t\t\tnianling: '',\r\n\t\t\t\t\tlianxifangshi: '',\r\n\t\t\t\t\tjiatingzhuzhi: '',\r\n\t\t\t\t\tbingshi: '',\r\n\t\t\t\t\tpquestion: '',\r\n\t\t\t\t\tpanswer: '',\r\n\t\t\t\t},\r\n\t\t\t\txingbieOptions: [],\r\n\r\n\t\t\t\trules: {\r\n\t\t\t\t\tyonghuzhanghao: [\r\n\t\t\t\t\t\t{ required: true, message: '用户账号不能为空', trigger: 'blur' },\r\n\t\t\t\t\t\t{ min: 3, max: 16, message: '长度范围3~16' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\tmima: [\r\n\t\t\t\t\t\t{ required: true, message: '密码不能为空', trigger: 'blur' },\r\n\t\t\t\t\t\t{ min: 3, message: '长度必须大于等于3' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\tyonghuxingming: [\r\n\t\t\t\t\t\t{ required: true, message: '用户姓名不能为空', trigger: 'blur' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\ttouxiang: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\txingbie: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\tnianling: [\r\n\t\t\t\t\t\t{ validator: this.$validate.isIntNumer, trigger: 'blur' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\tlianxifangshi: [\r\n\t\t\t\t\t\t{ validator: this.$validate.isMobile, trigger: 'blur' },\r\n\t\t\t\t\t],\r\n\t\t\t\t\tjiatingzhuzhi: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\tbingshi: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\tpquestion: [\r\n\t\t\t\t\t],\r\n\t\t\t\t\tpanswer: [\r\n\t\t\t\t\t],\r\n\t\t\t\t},\r\n\t\t\t\tcenterType: false,\r\n\t\t\t};\r\n\t\t},\r\n\t\tcomputed: {\r\n\t\t\tsessionForm() {\r\n\t\t\t\treturn JSON.parse(localStorage.getItem('sessionForm'))\r\n\t\t\t},\r\n\r\n\r\n\r\n\t\t},\r\n\t\tcomponents: {\r\n\t\t},\r\n\t\tcreated() {\r\n\t\t\tif(this.$route.query.centerType){\r\n\t\t\t\tthis.centerType = true\r\n\t\t\t}\r\n\t\t\t//this.bg();\r\n\t\t\tlet type = this.$route.query.type ? this.$route.query.type : '';\r\n\t\t\tthis.init(type);\r\n\t\t\tthis.baseUrl = this.$config.baseUrl;\r\n\t\t},\r\n\t\tmethods: {\r\n\t\t\tgetMakeZero(s) {\r\n\t\t\t\treturn s < 10 ? '0' + s : s;\r\n\t\t\t},\r\n\t\t\t// 下载\r\n\t\t\tdownload(file ){\r\n\t\t\t\twindow.open(`${file}`)\r\n\t\t\t},\r\n\t\t\t// 初始化\r\n\t\t\tinit(type) {\r\n\t\t\t\tthis.type = type;\r\n\t\t\t\tif(type=='cross'){\r\n\t\t\t\t\tvar obj = JSON.parse(localStorage.getItem('crossObj'));\r\n\t\t\t\t\tfor (var o in obj){\r\n\t\t\t\t\t\tif(o=='yonghuzhanghao'){\r\n\t\t\t\t\t\t\tthis.ruleForm.yonghuzhanghao = obj[o];\r\n\t\t\t\t\t\t\tthis.ro.yonghuzhanghao = true;\r\n\t\t\t\t\t\t\tcontinue;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif(o=='mima'){\r\n\t\t\t\t\t\t\tthis.ruleForm.mima = obj[o];\r\n\t\t\t\t\t\t\tthis.ro.mima = true;\r\n\t\t\t\t\t\t\tcontinue;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif(o=='yonghuxingming'){\r\n\t\t\t\t\t\t\tthis.ruleForm.yonghuxingming = obj[o];\r\n\t\t\t\t\t\t\tthis.ro.yonghuxingming = true;\r\n\t\