<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dao.PaiduijinduDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.PaiduijinduEntity" id="paiduijinduMap">
        <result property="shenqingbianhao" column="shenqingbianhao"/>
        <result property="ziyuanbianhao" column="ziyuanbianhao"/>
        <result property="ziyuanmingcheng" column="ziyuanmingcheng"/>
        <result property="ziyuantupian" column="ziyuantupian"/>
        <result property="ziyuanfenlei" column="ziyuanfenlei"/>
        <result property="ziyuanjiage" column="ziyuanjiage"/>
        <result property="paiduixuhao" column="paiduixuhao"/>
        <result property="muqianpaixu" column="muqianpaixu"/>
        <result property="yonghuzhanghao" column="yonghuzhanghao"/>
        <result property="yishenggonghao" column="yishenggonghao"/>
        <result property="gengxinshijian" column="gengxinshijian"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.PaiduijinduVO" >
		SELECT * FROM paiduijindu  paiduijindu         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.PaiduijinduVO" >
		SELECT  paiduijindu.* FROM paiduijindu  paiduijindu 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.PaiduijinduView" >

		SELECT  paiduijindu.* FROM paiduijindu  paiduijindu 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.PaiduijinduView" >
		SELECT * FROM paiduijindu  paiduijindu <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
