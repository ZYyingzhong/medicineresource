	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.YishengEntity" id="yishengMap">
        <result property="yishenggonghao" column="yishenggonghao"/>
        <result property="mima" column="mima"/>
        <result property="yishengxingming" column="yishengxingming"/>
        <result property="touxiang" column="touxiang"/>
        <result property="zhixingzigezheng" column="zhixingzigezheng"/>
        <result property="keshimingcheng" column="keshimingcheng"/>
        <result property="zhicheng" column="zhicheng"/>
        <result property="fuwushijian" column="fuwushijian"/>
        <result property="shanzhanglingyu" column="shanzhanglingyu"/>
        <result property="zhiyelvli" column="zhiyelvli"/>
        <result property="sfsh" column="sfsh"/>
